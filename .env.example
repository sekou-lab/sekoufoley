# ============================================================
# Calexo HVAC Voice Agent – Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Public HTTPS URL of this deployment (set automatically by Railway)
# Example: https://calexo-hvac-agent.up.railway.app
SERVER_URL=https://your-railway-domain.up.railway.app

# ── Claude / Anthropic (required for demo mode only) ─────────
# From https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Vapi ─────────────────────────────────────────────────────
# From https://dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=vapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: shared secret for webhook signature verification
# Generate with: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=

# Populated AFTER running: node scripts/setup-assistant.js
VAPI_ASSISTANT_ID=

# Populated AFTER running: node scripts/setup-phone.js
VAPI_PHONE_NUMBER_ID=

# ── HouseCall Pro ─────────────────────────────────────────────
# From https://app.housecallpro.com → Settings → Integrations → API
HCP_API_KEY=hcp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: webhook signature secret (set in HCP → Integrations → Webhooks)
HCP_WEBHOOK_SECRET=

# Diagnostic service-call fee in cents (default: $89.00)
HCP_SERVICE_CALL_PRICE_CENTS=8900

# ── Twilio ───────────────────────────────────────────────────
# From https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Twilio phone number that sends SMS confirmations (+E.164 format)
TWILIO_FROM_NUMBER=+14235550001

# ── Company (optional overrides) ─────────────────────────────
COMPANY_PHONE=+14235550000
